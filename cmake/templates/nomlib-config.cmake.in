@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set_and_check(NOMLIB_INCLUDE_DIR "@PACKAGE_NOMLIB_INCLUDE_INSTALL_DIR@")
set_and_check(NOMLIB_LIB_DIR "@PACKAGE_NOMLIB_LIB_INSTALL_DIR@")
set_and_check(NOMLIB_SHARE_DIR "@PACKAGE_NOMLIB_SHARE_INSTALL_DIR@")
set_and_check(NOMLIB_RESOURCES_DIR "@PACKAGE_NOMLIB_RESOURCES_INSTALL_DIR@")

set(NOMLIB_FOUND TRUE)
set(NOMLIB_LIBRARIES "")
set(NOMLIB_INCLUDE_DIRS "${NOMLIB_INCLUDE_DIR}")
set(NOMLIB_EXTERNAL_INCLUDE_DIRS "")
set(NOMLIB_DEPENDENCIES "")

if(NOT TARGET nomlib::nomlib-core)
  include("${CMAKE_CURRENT_LIST_DIR}/nomlib-targets.cmake")
endif()

set(_nomlib_supported_components
  core
  file
  math
  ptree
  serializers
  system
  graphics
  gui
  audio
  actions
)

set(_nomlib_required_vars "")

foreach(_comp ${nomlib_FIND_COMPONENTS})
  list(FIND _nomlib_supported_components ${_comp} _comp_index)
  if(_comp_index EQUAL -1)
    message(FATAL_ERROR "Unknown nomlib component: ${_comp}")
  endif()

  if(TARGET nomlib::nomlib-${_comp})
    set(nomlib_${_comp}_FOUND TRUE)
    list(APPEND NOMLIB_LIBRARIES nomlib::nomlib-${_comp})
    list(APPEND _nomlib_required_vars nomlib::nomlib-${_comp})
  else()
    set(nomlib_${_comp}_FOUND FALSE)
    if(nomlib_FIND_REQUIRED_${_comp})
      set(NOMLIB_FOUND FALSE)
      set(NOMLIB_NOT_FOUND_MESSAGE "Missing required nomlib component: ${_comp}")
    endif()
  endif()
endforeach()

if(nomlib_FIND_COMPONENTS)
  list(LENGTH NOMLIB_LIBRARIES _nomlib_lib_count)
  if(_nomlib_lib_count EQUAL 0)
    set(NOMLIB_FOUND FALSE)
    if(NOT NOMLIB_NOT_FOUND_MESSAGE)
      set(NOMLIB_NOT_FOUND_MESSAGE "No nomlib components found")
    endif()
  endif()
else()
  set(_nomlib_all_libs "")
  foreach(_comp ${_nomlib_supported_components})
    if(TARGET nomlib::nomlib-${_comp})
      list(APPEND NOMLIB_LIBRARIES nomlib::nomlib-${_comp})
    endif()
  endforeach()
endif()

check_required_components(nomlib)

if(NOMLIB_FOUND)
  message(STATUS "Found nomlib: ${NOMLIB_INCLUDE_DIR}")
  message(STATUS "nomlib resources: ${NOMLIB_RESOURCES_DIR}")
endif()
